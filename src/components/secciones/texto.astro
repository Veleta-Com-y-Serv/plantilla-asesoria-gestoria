---
// Apartado de texto genérico (apartados nuevos del cliente, site.yaml: `tipo: texto`): banda arena clara a todo el
// ancho. Con `imagen`, fila 50/50 a sangre (la foto toca el borde derecho, esquina grande hacia el texto); sin
// ella, titular a la izquierda y párrafos a la derecha. Admite `items` (titulo, texto, icono) y un botón (`cta`).
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <section id={Astro.props.id} class:list={['apartado banda--clara', { 'con-foto': !!s.imagen }]}>
      <div class="apartado-texto">
        <div>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
        </div>
        <div>
          {s.texto && (
            <div class="apartado-parrafos">
              {parrafos(s.texto).map((p) => <p>{p}</p>)}
            </div>
          )}
          {s.items.length > 0 && (
            <ul class="apartado-lista">
              {s.items.map((it) => (
                <li>
                  <span class="apartado-icono"><Icono nombre={it.icono} tam={22} /></span>
                  <div>
                    <p class="apartado-item">{it.titulo}</p>
                    {it.texto && <p class="apartado-item-texto">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <a class="btn btn--verde mt-10" href={s.cta.url}>{s.cta.texto}</a>}
        </div>
      </div>
      {s.imagen && (
        <div class="apartado-foto foto-curva--izq">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
        </div>
      )}
    </section>
  )
}

<style>
  .apartado { display: grid; }
  .apartado-texto { width: 100%; max-width: var(--ancho); margin-inline: auto; padding: var(--ritmo) 1rem; display: grid; gap: 2rem; }
  @media (min-width: 768px) { .apartado-texto { padding: var(--ritmo-md) 2rem; } }
  @media (min-width: 1024px) { .apartado:not(.con-foto) .apartado-texto { grid-template-columns: 5fr 7fr; gap: 6rem; } }
  @media (min-width: 1200px) { .apartado:not(.con-foto) .apartado-texto { padding-inline: 3rem; } }
  @media (min-width: 1024px) {
    .apartado.con-foto { grid-template-columns: 1fr 1fr; }
    .apartado.con-foto .apartado-texto { max-width: none; margin: 0; padding: var(--ritmo-md) clamp(3rem, 5vw, 6rem) var(--ritmo-md) max(3rem, calc((100vw - var(--ancho)) / 2 + 3rem)); }
  }
  .apartado-foto { position: relative; min-height: 22rem; margin-left: 1rem; }
  @media (min-width: 1024px) { .apartado-foto { margin: 0; } }
  .apartado-foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .apartado-parrafos { display: grid; gap: 1.1rem; font-size: 1.1rem; opacity: .88; max-width: 42rem; }
  .apartado-lista { margin-top: 2.5rem; border-top: .35rem solid var(--verde); }
  .apartado-lista li { display: flex; gap: 1rem; padding-block: 1.2rem; border-bottom: 1px solid var(--raya); }
  .apartado-icono { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 999px; background: var(--verde); color: var(--arena); }
  .apartado-item { font-family: var(--fuente-titulos); font-weight: 800; letter-spacing: -0.02em; font-size: 1.25rem; color: var(--verde); }
  .apartado-item-texto { font-size: .98rem; opacity: .8; }
</style>
