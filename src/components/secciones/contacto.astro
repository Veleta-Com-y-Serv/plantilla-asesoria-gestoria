---
// Contacto: dos bandas a todo el ancho. Arriba, verde hondo rayado con el titular y los datos en columnas grandes
// (teléfono, WhatsApp, correo, dirección, horario). Abajo, fila 50/50: formulario (mailto) sobre blanco y la foto
// `imagen` a sangre por la derecha con la esquina grande hacia el formulario. El desplegable «¿Para quién es la
// consulta?» sale de los `para` de los servicios, si los hay. Sin foto, el formulario va solo y más ancho.
import { seccion, site, tel, mapa, whatsapp } from '../../data/site';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const datos = [
  c.telefono && { icono: 'telefono', etiqueta: 'Teléfono', valor: c.telefono, url: tel(c.telefono) },
  c.whatsapp && { icono: 'whatsapp', etiqueta: 'WhatsApp', valor: c.whatsapp, url: whatsapp(c.whatsapp) },
  c.email && { icono: 'correo', etiqueta: 'Correo', valor: c.email, url: `mailto:${c.email}` },
  c.direccion && { icono: 'mapa', etiqueta: 'Oficina', valor: c.direccion, url: mapa(c.direccion) },
  c.horario && { icono: 'reloj', etiqueta: 'Horario', valor: c.horario, url: '' },
].filter(Boolean) as { icono: string; etiqueta: string; valor: string; url: string }[];
// Opciones del formulario: los `para` distintos de los servicios activos
const opciones = [
  ...new Set(
    Object.values(site.secciones)
      .filter((x) => x.activa)
      .flatMap((x) => x.servicios.map((v) => String(v?.para ?? '').trim()))
      .filter(Boolean),
  ),
];
---

{
  s && (
    <section id={Astro.props.id} class="contacto">
      <div class="contacto-cabeza banda--hondo rayado">
        <div class="contenedor">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="contacto-titulo">{s.titulo}</h2>}
          {s.texto && <p class="contacto-texto">{s.texto}</p>}
          {datos.length > 0 && (
            <dl class="contacto-datos">
              {datos.map((d) => (
                <div class="contacto-dato">
                  <dt><Icono nombre={d.icono} tam={18} />{d.etiqueta}</dt>
                  <dd>{d.url ? <a href={d.url} rel={d.url.startsWith('http') ? 'noopener' : undefined} target={d.url.startsWith('http') ? '_blank' : undefined}>{d.valor}</a> : d.valor}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
      <div class:list={['contacto-fila', { 'con-foto': !!s.imagen }]}>
        <div class="contacto-formulario">
          <FormularioContacto boton="Pedir mi consulta" opciones={opciones} etiquetaMensaje="¿A qué te dedicas y qué necesitas?" />
        </div>
        {s.imagen && (
          <div class="contacto-foto foto-curva--izq">
            <Imagen src={s.imagen} alt="" ancho={1200} alto={900} />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .contacto-cabeza { padding-block: var(--ritmo); color: var(--sobre-verde); }
  @media (min-width: 768px) { .contacto-cabeza { padding-block: var(--ritmo-md) 5rem; } }
  .contacto-titulo { margin-top: 1rem; font-size: clamp(2.6rem, 7.5vw, 6rem); line-height: .96; letter-spacing: -0.045em; color: #fff; max-width: 14ch; }
  .contacto-texto { margin-top: 1.25rem; max-width: 38rem; font-size: 1.15rem; opacity: .9; }
  .contacto-datos { display: grid; gap: 0 2rem; margin-top: 3rem; border-top: 1px solid var(--raya-clara); }
  @media (min-width: 640px) { .contacto-datos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .contacto-datos { grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); } }
  .contacto-dato { padding-block: 1.25rem; border-bottom: 1px solid var(--raya-clara); }
  .contacto-dato dt { display: flex; align-items: center; gap: .5rem; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--arena); }
  .contacto-dato dd { margin-top: .4rem; font-family: var(--fuente-titulos); font-weight: 800; letter-spacing: -0.02em; font-size: 1.2rem; line-height: 1.3; color: #fff; overflow-wrap: anywhere; }
  .contacto-dato a { text-decoration: none; }
  .contacto-dato a:hover { color: var(--arena); text-decoration: underline; }
  .contacto-fila { display: grid; background: var(--blanco); }
  .contacto-formulario { width: 100%; max-width: 52rem; margin-inline: auto; padding: 4rem 1rem; }
  @media (min-width: 768px) { .contacto-formulario { padding: 5.5rem 2rem; } }
  .contacto-foto { position: relative; min-height: 18rem; margin-left: 1rem; }
  .contacto-foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 1024px) {
    .contacto-fila.con-foto { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .contacto-fila.con-foto .contacto-formulario { max-width: none; margin: 0; padding: 6rem clamp(3rem, 5vw, 6rem) 6rem max(3rem, calc((100vw - var(--ancho)) / 2 + 3rem)); }
    .contacto-foto { margin: 0; min-height: 0; }
  }
</style>
