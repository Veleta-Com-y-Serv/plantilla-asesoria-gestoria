---
// Portada de color pleno: banda verde bosque con rayado de libro de cuentas, título enorme en sans pesada, párrafo
// corto y dos botones. A la derecha, la foto `imagen` a sangre (toca el borde derecho y el de abajo, con la esquina
// grande mirando al texto) y, flotando sobre su borde, las `cifras` en fichas escalonadas (titulo = cifra,
// texto = etiqueta). En móvil: texto, cifras en rejilla 2×2 y la foto a sangre debajo. Sin foto ni cifras, solo
// el texto sobre verde. Sin cifras no hay fichas.
import { seccion } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const cifras = s ? s.cifras.filter((c) => c && c.titulo).slice(0, 4) : [];
const conVisual = !!s && (!!s.imagen || cifras.length > 0);
---

{
  s && (
    <section id={id} class:list={['portada rayado', { 'con-visual': conVisual }]}>
      <div class="portada-texto">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        <h1 class="portada-titulo">{s.titulo}</h1>
        {s.texto && <p class="portada-parrafo">{s.texto}</p>}
        {(s.cta?.url || s.cta_secundario?.url) && (
          <div class="portada-botones">
            {s.cta?.url && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
            {s.cta_secundario?.url && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
          </div>
        )}
      </div>
      {conVisual && (
        <div class:list={['portada-visual', { 'sin-foto': !s.imagen }]}>
          {s.imagen && (
            <div class="portada-foto foto-curva--izq">
              <Imagen src={s.imagen} alt={altHero()} ancho={1200} alto={1600} prioridad={primera} />
            </div>
          )}
          {cifras.length > 0 && (
            <ul class="portada-cifras" aria-label="Datos de la asesoría">
              {cifras.map((c) => (
                <li class="ficha">
                  <span class="ficha-cifra">{c.titulo}</span>
                  {c.texto && <span class="ficha-texto">{c.texto}</span>}
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </section>
  )
}

<style>
  .portada { display: grid; background-color: var(--verde); color: var(--sobre-verde); overflow: hidden; }
  :global(main) > .portada:first-child { min-height: calc(92svh - var(--alto-cabecera)); }
  .portada-texto { padding: 4rem 1rem 3rem; align-self: center; }
  @media (min-width: 768px) { .portada-texto { padding: 6rem 2rem 4rem; } }
  .portada .antetitulo { color: var(--arena); }
  .portada-titulo { margin-top: 1.5rem; font-size: clamp(2.7rem, 8.4vw, 6.75rem); line-height: .96; letter-spacing: -0.045em; color: #fff; max-width: 12ch; }
  .portada-parrafo { margin-top: 1.75rem; max-width: 36rem; font-size: clamp(1.05rem, 1.5vw, 1.3rem); opacity: .92; }
  .portada-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.5rem; }
  .portada-botones .btn-sec { color: #fff; }
  @media (max-width: 479px) { .portada-botones a { width: 100%; } }

  .portada-visual { position: relative; display: grid; gap: 1.5rem; }
  .portada-foto { position: relative; aspect-ratio: 4 / 3; margin-left: 1rem; }
  .portada-foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .portada-cifras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; padding-inline: 1rem; order: -1; }
  .ficha { display: grid; gap: .25rem; align-content: start; padding: 1.1rem 1.1rem 1.2rem; border-radius: var(--radio) var(--radio) var(--radio) 0; background: var(--arena); color: var(--verde-hondo); box-shadow: 0 18px 40px -22px rgb(0 0 0 / .55); }
  .ficha:nth-child(2) { background: var(--blanco); color: var(--verde); }
  .ficha:nth-child(3) { background: var(--verde-hondo); color: #fff; outline: 1px solid var(--raya-clara); }
  .ficha:nth-child(4) { background: var(--arena-clara); color: var(--verde-hondo); }
  .ficha-cifra { font-family: var(--fuente-titulos); font-weight: 800; font-size: clamp(1.9rem, 4vw, 3.1rem); line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .ficha-texto { font-size: .88rem; font-weight: 600; line-height: 1.3; opacity: .85; }

  @media (min-width: 1024px) {
    .portada.con-visual { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .portada-texto { padding: 6rem 4rem 6rem max(3rem, calc((100vw - var(--ancho)) / 2 + 3rem)); }
    .portada-visual { display: block; min-height: 34rem; }
    .portada-foto { position: absolute; inset: 3.5rem 0 0 0; margin: 0; aspect-ratio: auto; }
    .portada-visual.sin-foto { background: var(--verde-hondo); }
    .portada-cifras { position: absolute; inset: 0; display: block; padding: 0; }
    .ficha { position: absolute; width: min(14rem, 80%); }
    .ficha:nth-child(1) { top: 9%; left: -3.5rem; }
    .ficha:nth-child(2) { top: 30%; left: 4rem; }
    .ficha:nth-child(3) { top: 52%; left: -2rem; }
    .ficha:nth-child(4) { top: 73%; left: 5.5rem; }
  }
</style>
