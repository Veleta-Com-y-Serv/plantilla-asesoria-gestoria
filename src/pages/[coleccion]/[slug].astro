---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «libro de cuentas»: banda verde rayada a todo el ancho con migas y hero partido (título enorme en blanco,
// texto, precio y botones; a la derecha la foto con la esquina curva o, sin foto, su icono grande en un bloque arena);
// banda blanca con el `detalle` y, al lado, la tabla de datos (barra verde gruesa) y la caja de consulta en arena;
// franja de fotos a sangre (`imagenes`); y otros servicios de la lista en filas rayadas sobre arena clara.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cita = seccion('cita') ? enlace('/#cita') : site.boton_cabecera?.url || enlace('/#contacto');
const textoCita = site.boton_cabecera?.texto || 'Primera consulta gratis';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--verde rayado ficha-cabeza oscuro">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-chips"><span class="ficha-precio">{f.precio}</span></p>}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto foto-curva">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono foto-curva" aria-hidden="true"><Icono nombre={f.icono || 'documento'} tam={110} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--blanco">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita">
          <p class="ficha-cita-titulo">¿Hablamos de tu caso?</p>
          <p>La primera consulta es gratis y sin compromiso: te decimos qué haría falta y cuánto costaría.</p>
          <a class="btn btn--verde" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="ficha-franja" aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria">
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--clara">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'documento'} tam={22} /></span>
              <div>
                <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
                {o.texto && <p>{o.texto}</p>}
                <p class="ficha-otra-pie">
                  {o.precio && <span class="ficha-precio">{o.precio}</span>}
                  <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
                </p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-12"><a class="btn btn--verde" href={rutaDeSeccion(f.idSeccion)}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3.5rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 700; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .6; }
  .migas a { color: var(--arena); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .8; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.4rem, 7vw, 5.25rem); overflow-wrap: anywhere; }
  .ficha-chips { margin-top: 1.5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.3rem; font-variant-numeric: tabular-nums; color: var(--verde); }
  .ficha-chips .ficha-precio { display: inline-block; padding: .35rem 1rem; border-radius: 999px; background: var(--arena); color: var(--verde-hondo); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; background: var(--verde-hondo); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--arena); color: var(--verde-hondo); }
  .ficha-cuerpo { display: grid; gap: 3.5rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.3rem; }
  .ficha-detalle p:first-child { font-size: 1.3rem; font-weight: 600; color: var(--tinta-verde); }
  .ficha-lado { display: grid; gap: 1.75rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.6rem; color: var(--verde); padding-bottom: .8rem; border-bottom: .45rem solid var(--verde); }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .95rem 0; border-bottom: 1px solid var(--raya); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .ficha-cita { display: grid; gap: .9rem; padding: 1.9rem 1.6rem; background: var(--arena); color: var(--c-texto); border-radius: .75rem .75rem .75rem 0; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.7rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; color: var(--tinta-verde); }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: var(--verde-hondo); text-decoration: none; }
  .ficha-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 16 / 10; max-height: 26rem; overflow: hidden; }
  .ficha-otras { display: grid; border-top: .45rem solid var(--verde); column-gap: 3rem; }
  .ficha-otra { position: relative; display: flex; gap: 1rem; padding-block: 1.5rem; border-bottom: 1px solid var(--raya); }
  .ficha-otra-icono { display: grid; place-items: center; flex: none; width: 2.9rem; height: 2.9rem; border-radius: 999px; background: var(--arena); color: var(--verde); }
  .ficha-otra h3 { font-size: 1.3rem; line-height: 1.15; }
  .ficha-otra-enlace { text-decoration: none; color: var(--c-texto); }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--verde); outline-offset: 2px; }
  .ficha-otra p { margin-top: .4rem; font-size: .98rem; opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; gap: 1rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; color: var(--verde); }
  @media (min-width: 768px) { .ficha-otras { grid-template-columns: repeat(3, minmax(0, 1fr)); } .ficha-otra { flex-direction: column; } }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
