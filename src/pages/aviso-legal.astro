---
// Aviso legal y privacidad con el diseño de la plantilla: cabecera en banda verde rayada a todo el ancho y el texto
// en banda blanca, con los datos del titular en una ficha arena a la izquierda. Se enlaza desde el pie.
import Base from '../layouts/Base.astro';
import { site, tel } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda banda--verde rayado legal-cabeza">
    <div class="contenedor">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="legal-titulo">Aviso legal y privacidad</h1>
    </div>
  </section>
  <section class="banda banda--blanco">
    <div class="contenedor legal-rejilla">
      <aside class="legal-ficha">
        <p class="legal-ficha-titulo">Titular de la web</p>
        <p class="legal-ficha-nombre">{site.nombre}</p>
        {c.direccion && <p>{c.direccion}</p>}
        {c.email && <p class="break-words"><a href={`mailto:${c.email}`}>{c.email}</a></p>}
        {c.telefono && <p><a href={tel(c.telefono)}>{c.telefono}</a></p>}
      </aside>
      <article class="texto-largo legal-texto">
        <h2>Quiénes somos</h2>
        <p>
          Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
            c.email || 'nuestro correo de contacto'
          }{c.telefono && ` o llamarnos al ${c.telefono}`}.
        </p>
        <h2>Qué datos tratamos</h2>
        <p>
          Solo los que nos envías al escribirnos: nombre, forma de contacto y tu mensaje. Los usamos para responderte. No
          los cedemos a nadie salvo obligación legal, y los tratamos con confidencialidad.
        </p>
        <h2>Cuánto tiempo los guardamos</h2>
        <p>El necesario para atender tu consulta y, después, el que marque la ley.</p>
        <h2>Tus derechos</h2>
        <p>
          Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
          puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
        </p>
        <h2>Cookies</h2>
        <p>Esta web no usa cookies de seguimiento.</p>
        <p class="mt-10"><a class="btn btn--verde" href="/">Volver al inicio</a></p>
      </article>
    </div>
  </section>
</Base>

<style>
  .legal-cabeza { padding-block: 4rem; }
  @media (min-width: 768px) { .legal-cabeza { padding-block: 6rem; } }
  .legal-titulo { margin-top: 1.25rem; font-size: clamp(2.4rem, 7vw, 5.5rem); line-height: .98; letter-spacing: -0.045em; color: #fff; }
  .legal-rejilla { display: grid; gap: 3rem; }
  @media (min-width: 1024px) { .legal-rejilla { grid-template-columns: 4fr 8fr; gap: 6rem; } }
  .legal-ficha { display: grid; gap: .4rem; align-content: start; padding: 1.75rem; border-radius: var(--radio) var(--radio) var(--radio) 0; background: var(--arena-clara); }
  .legal-ficha-titulo { font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--verde); margin-bottom: .5rem; }
  .legal-ficha-nombre { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.3rem; color: var(--verde); }
  .legal-texto { max-width: 46rem; }
  .legal-texto h2:first-child { margin-top: 0; }
</style>
